# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=            # speech-to-text (Whisper) + choosing the best takes
REEL_API_KEY=              # any long random string; n8n and the website send it to the server
JOBS_DIR=C:\Users\you\reel-jobs   # where raw videos and finished reels are stored (outside OneDrive: files are large)
N8N_BASE=https://n8n.barqdigitalai.com
N8N_API_KEY=               # lets start_editor.py update the n8n form with the current tunnel link
VERCEL_TOKEN=              # lets start_editor.py update and redeploy the website
VERCEL_SCOPE=              # Vercel team slug
APP_PASSWORD=              # only used if the website is locked (REQUIRE_PASSWORD=true on Vercel)
